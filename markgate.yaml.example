# markgate.yaml.example — copy to markgate.yaml and fill in your values.
#
# markgate.yaml is gitignored by default (it may contain API tokens).
# Commit this example file instead.

backends:
  google_docs:
    # Service-account auth (app / non-user):
    credentials_path: /path/to/service-account.json
    # or set ACCOUNT_A_CREDENTIALS_PATH env var
    #
    # Or per-user OAuth (acts as you, like gws — no service account):
    # oauth_client_secret_path: /path/to/client_secret.json
    # token_path: .markgate/google_token.json   # cached user token (default)

  confluence:
    base_url: https://yourorg.atlassian.net
    username: you@yourorg.com
    # api_token: set via CONFLUENCE_API_TOKEN env var

# A relative markdown link from one mapped file to another (e.g.
# `[link](page.md#some-heading)` inside design-doc.md, below) is resolved to
# the target's Google Doc edit URL at push time — both files need a mapping
# entry here for that to work. See docs/backends/google-docs.md#limitations
# for what's still out of scope in v1 (cross-backend targets, dry-run).
mappings:
  - local: docs/design-doc.md
    backend: google_docs
    remote_id: YOUR_GOOGLE_DOC_ID
    direction: both

  - local: docs/page.md
    backend: confluence
    remote_id: YOUR_CONFLUENCE_PAGE_ID
    direction: both
